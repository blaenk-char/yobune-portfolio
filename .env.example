# Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[server]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[server]:5432/postgres"

# Supabase
NUXT_SUPABASE_SECRET_KEY="sb_secret_[secret-key]"
NUXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NUXT_PUBLIC_SUPABASE_KEY="sb_publishable_[publishable-key]"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="[google-client-id]"
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET="[google-client-secret]"

# App
NODE_ENV="development"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
